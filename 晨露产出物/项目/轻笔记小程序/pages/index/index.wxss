/* 首页样式 - 精致版 */

/* 头部 */
.header {
  background: linear-gradient(135deg, #5B9BD5 0%, #7BB3E0 100%);
  padding: 48rpx 32rpx;
  text-align: center;
  position: relative;
  overflow: hidden;
}

.header::before {
  content: '';
  position: absolute;
  top: -50%;
  left: -50%;
  width: 200%;
  height: 200%;
  background: radial-gradient(circle, rgba(255,255,255,0.15) 0%, transparent 60%);
}

.title {
  display: block;
  font-size: 48rpx;
  color: white;
  margin-bottom: 12rpx;
  font-weight: 600;
  position: relative;
  text-shadow: 0 2rpx 4rpx rgba(0,0,0,0.1);
}

.subtitle {
  font-size: 26rpx;
  color: rgba(255,255,255,0.9);
  position: relative;
}

/* 模式切换 */
.mode-switch {
  display: flex;
  background: #F0F7FA;
  border-radius: 32rpx;
  padding: 6rpx;
  margin-bottom: 24rpx;
  width: fit-content;
}

.mode-btn {
  padding: 16rpx 40rpx;
  border-radius: 26rpx;
  font-size: 28rpx;
  color: #718096;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  font-weight: 500;
}

.mode-btn.active {
  background: linear-gradient(135deg, #5B9BD5 0%, #7BB3E0 100%);
  color: white;
  box-shadow: 0 4rpx 16rpx rgba(91, 155, 213, 0.3);
}

/* 输入框 */
.input-box {
  width: 100%;
  min-height: 200rpx;
  background: #F8FAFC;
  border: 2rpx solid #E2E8F0;
  border-radius: 20rpx;
  padding: 24rpx;
  font-size: 30rpx;
  color: #4A5568;
  box-sizing: border-box;
  transition: all 0.3s;
}

.input-box:focus {
  border-color: #5B9BD5;
  background: white;
  box-shadow: 0 0 0 4rpx rgba(91, 155, 213, 0.1);
}

/* 任务列表 */
.task-list {
  background: #F8FAFC;
  border-radius: 20rpx;
  padding: 16rpx 24rpx;
}

.task-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #E2E8F0;
}

.task-item:last-child {
  border-bottom: none;
}

.task-checkbox {
  width: 40rpx;
  height: 40rpx;
  border: 2rpx solid #5B9BD5;
  border-radius: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: white;
  transition: all 0.2s;
}

.task-checkbox.checked {
  background: linear-gradient(135deg, #5B9BD5 0%, #7BB3E0 100%);
  border-color: #5B9BD5;
}

.task-checkbox.checked::after {
  content: "✓";
  color: white;
  font-size: 24rpx;
  font-weight: bold;
}

.task-input {
  flex: 1;
  font-size: 30rpx;
  color: #4A5568;
  background: transparent;
  border: none;
}

.add-task {
  color: #5B9BD5;
  font-size: 28rpx;
  padding: 20rpx 0;
  text-align: center;
}

/* 操作按钮 */
.input-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 24rpx;
}

/* 分类列表 */
.category-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
  margin-bottom: 16rpx;
  background: linear-gradient(135deg, #F8FAFC 0%, #FFFFFF 100%);
  border-radius: 20rpx;
  transition: all 0.3s;
  border: 1rpx solid rgba(184, 212, 232, 0.2);
}

.category-item:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 16rpx rgba(91, 155, 213, 0.1);
}

.category-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.category-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  background: linear-gradient(135deg, #E8F4FC 0%, #F0F7FA 100%);
}

.category-name {
  font-size: 32rpx;
  color: #2D3748;
  margin-bottom: 6rpx;
  font-weight: 600;
  display: block;
}

.category-desc {
  font-size: 24rpx;
  color: #A0AEC0;
}

.category-count {
  background: linear-gradient(135deg, #E8F4FC 0%, #F0F7FA 100%);
  color: #5B9BD5;
  padding: 10rpx 28rpx;
  border-radius: 28rpx;
  font-size: 26rpx;
  font-weight: 600;
}

/* 子分类 */
.sub-categories {
  margin-left: 100rpx;
  margin-top: 12rpx;
}

.sub-category {
  padding: 16rpx 0;
  font-size: 28rpx;
  color: #718096;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

/* 最近编辑 */
.note-item {
  padding: 24rpx;
  background: linear-gradient(135deg, #F8FAFC 0%, #FFFFFF 100%);
  border-radius: 20rpx;
  margin-bottom: 16rpx;
  border-left: 6rpx solid #5B9BD5;
  border: 1rpx solid rgba(184, 212, 232, 0.2);
  border-left-width: 6rpx;
  transition: all 0.3s;
}

.note-item:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 16rpx rgba(91, 155, 213, 0.1);
}

.note-content {
  font-size: 32rpx;
  color: #2D3748;
  margin-bottom: 12rpx;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.note-meta {
  font-size: 24rpx;
  color: #A0AEC0;
}

/* 分类弹窗 */
.category-popup {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
}

.popup-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.5);
}

.popup-content {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: white;
  border-radius: 32rpx 32rpx 0 0;
  padding: 40rpx;
  max-height: 60vh;
}

.popup-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #2D3748;
  text-align: center;
  margin-bottom: 32rpx;
}

.popup-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 24rpx;
  font-size: 32rpx;
  color: #4A5568;
  border-bottom: 1rpx solid #F0F4F8;
}

.check-icon {
  color: #5B9BD5;
  font-size: 36rpx;
  font-weight: bold;
}