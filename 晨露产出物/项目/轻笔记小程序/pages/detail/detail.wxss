/* 详情页样式 */
.detail-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
  background: white;
  border-bottom: 1rpx solid #F0F4F8;
}

.back-btn {
  font-size: 32rpx;
  color: #5B9BD5;
  padding: 12rpx;
}

.header-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #2D3748;
}

.header-actions {
  display: flex;
  gap: 24rpx;
}

.action-btn {
  font-size: 28rpx;
  color: #718096;
  padding: 12rpx;
}

.action-btn.delete {
  color: #E53E3E;
}

/* 编辑区 */
.edit-section {
  padding: 32rpx;
}

.category-tag {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  background: linear-gradient(135deg, #E8F4FC 0%, #F0F7FA 100%);
  color: #5B9BD5;
  padding: 12rpx 24rpx;
  border-radius: 24rpx;
  font-size: 26rpx;
  margin-bottom: 24rpx;
}

.edit-input {
  width: 100%;
  min-height: 400rpx;
  font-size: 32rpx;
  line-height: 1.8;
  color: #4A5568;
  background: transparent;
  border: none;
}

.time-info {
  padding: 24rpx 32rpx;
  font-size: 24rpx;
  color: #A0AEC0;
  border-top: 1rpx solid #F0F4F8;
}