/* 全局样式 - 柔和蓝色系 */
page {
  background: linear-gradient(180deg, #F0F7FA 0%, #F8FAFC 100%);
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
  color: #4A5568;
  min-height: 100vh;
}

.container {
  padding: 20rpx;
}

/* 卡片样式 */
.card {
  background: white;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 
    0 4rpx 6rpx -1rpx rgba(91, 155, 213, 0.05),
    0 2rpx 4rpx -1rpx rgba(91, 155, 213, 0.03);
  border: 1rpx solid rgba(184, 212, 232, 0.3);
}

/* 区块标题 */
.section-title {
  font-size: 28rpx;
  color: #5B9BD5;
  margin-bottom: 24rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
}

.section-title::before {
  content: '';
  width: 4rpx;
  height: 28rpx;
  background: linear-gradient(180deg, #5B9BD5 0%, #7BB3E0 100%);
  border-radius: 2rpx;
  margin-right: 12rpx;
}

/* 按钮样式 */
.btn {
  padding: 24rpx 40rpx;
  border-radius: 16rpx;
  font-size: 30rpx;
  text-align: center;
  transition: all 0.3s;
  font-weight: 500;
}

.btn-primary {
  background: linear-gradient(135deg, #5B9BD5 0%, #7BB3E0 100%);
  color: white;
  box-shadow: 0 4rpx 12rpx rgba(91, 155, 213, 0.3);
}

.btn-primary:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 8rpx rgba(91, 155, 213, 0.2);
}

.btn-secondary {
  background: white;
  color: #5B9BD5;
  border: 2rpx solid #B8D4E8;
}

.btn-secondary:active {
  background: #F0F7FA;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 80rpx 40rpx;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: 28rpx;
  color: #A0AEC0;
}